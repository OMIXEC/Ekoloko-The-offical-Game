region          = "eu-west-1"
name            = "ekoloko-dr"
backend_image   = "123456789012.dkr.ecr.eu-west-1.amazonaws.com/ekoloko-dr:1.0.0"
host            = "dr.example.com"
client_domain   = "dr.example.com"
# ACM certificate must be in the same region for the ALB and us-east-1 for CloudFront.
certificate_arn = "arn:aws:acm:eu-west-1:123456789012:certificate/xxxx"
# Set via TF_VAR_db_password / TF_VAR_session_secret (never commit these).
protect_data    = true
redis_num_nodes = 2

# secrets = {
#   ADMIN_TOKEN = "arn:aws:secretsmanager:eu-west-1:123456789012:secret:ekoloko-admin-token"
# }
