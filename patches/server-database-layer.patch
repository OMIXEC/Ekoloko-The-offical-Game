+/**
+ * Local compatibility data layer for the preservation server.
+ *
+ * The upstream repo imports `../database/Database` from every extension but
+ * does not ship the file. This implementation restores the data access surface
+ * using the schema created in `src/index.ts` plus the extra tables/columns the
+ * extension handlers expect. It is intentionally conservative: simple
+ * synchronous better-sqlite3 statements, no ORM.
+ */
+import SqliteDatabase from "better-sqlite3";
+import * as fs from "fs";
+import * as path from "path";
+
+type Row = any;
+
+export class Database {
+  private db: SqliteDatabase.Database;
+
+  constructor(filePath?: string) {
+    const target = filePath ?? path.resolve(__dirname, "../../database/ekoloko.db");
+    fs.mkdirSync(path.dirname(target), { recursive: true });
+    this.db = new SqliteDatabase(target);
+    this.db.pragma("journal_mode = WAL");
+    this.db.pragma("foreign_keys = ON");
+    this.ensureSchema();
+  }
+
+  // ── generic access ────────────────────────────────────────────────────
+  prepare(sql: string): SqliteDatabase.Statement {
+    return this.db.prepare(sql);
+  }
+
+  exec(sql: string): this {
+    this.db.exec(sql);
+    return this;
+  }
+
+  pragma(name: string, options?: any): any {
+    return this.db.pragma(name, options as any);
+  }
+
+  close(): void {
+    this.db.close();
+  }
+
+  all<T = Row>(sql: string, ...params: any[]): T[] {
+    return this.db.prepare(sql).all(...params) as T[];
+  }
+
+  private get(sql: string, ...params: any[]): Row {
+    return this.db.prepare(sql).get(...params) as Row;
+  }
+
+  private run(sql: string, ...params: any[]): void {
+    this.db.prepare(sql).run(...params);
+  }
+
+  private addColumn(table: string, column: string, definition: string): void {
+    try {
+      this.db.exec(`ALTER TABLE ${table} ADD COLUMN ${column} ${definition}`);
+    } catch (error) {
+      const message = String((error as Error).message);
+      if (!message.includes("duplicate column")) throw error;
+    }
+  }
+
+  /** Reconcile the schema created in index.ts with what extensions query. */
+  private ensureSchema(): void {
+    this.db.exec(`
+      CREATE VIEW IF NOT EXISTS accounts AS
+        SELECT id, username, email, password_hash, gender,
+               is_moderator AS mod_level, ranger_level, is_banned, ban_reason, created_at
+        FROM users;
+
+      CREATE VIEW IF NOT EXISTS players AS
+        SELECT id AS account_id, id, username, coins AS gold, credits, xp, level,
+               skin_tone, last_room_id, days_played, premium, ranger_level
+        FROM users;
+
+      CREATE TABLE IF NOT EXISTS rooms (
+        id INTEGER PRIMARY KEY, name TEXT NOT NULL DEFAULT '', swf_file TEXT NOT NULL DEFAULT '',
+        sound_file TEXT DEFAULT '', zone_name TEXT DEFAULT '', max_users INTEGER NOT NULL DEFAULT 50
+      );
+      CREATE TABLE IF NOT EXISTS room_portals (
+        id INTEGER PRIMARY KEY AUTOINCREMENT, room_id INTEGER NOT NULL, portal_id INTEGER NOT NULL,
+        target_room_id INTEGER NOT NULL
+      );
+      CREATE TABLE IF NOT EXISTS room_npcs (
+        id INTEGER PRIMARY KEY AUTOINCREMENT, room_id INTEGER NOT NULL, npc_id INTEGER NOT NULL
+      );
+      CREATE TABLE IF NOT EXISTS stores (
+        id INTEGER PRIMARY KEY, name TEXT NOT NULL DEFAULT '', store_type TEXT DEFAULT 'general',
+        items_json TEXT NOT NULL DEFAULT '[]'
+      );
+      CREATE TABLE IF NOT EXISTS houses (
+        player_id INTEGER PRIMARY KEY, type_id INTEGER NOT NULL DEFAULT 1,
+        size INTEGER NOT NULL DEFAULT 1, electric_level INTEGER NOT NULL DEFAULT 0,
+        garden_level INTEGER NOT NULL DEFAULT 0, locked INTEGER NOT NULL DEFAULT 0,
+        furniture TEXT NOT NULL DEFAULT '[]'
+      );
+      CREATE TABLE IF NOT EXISTS house_items (
+        id INTEGER PRIMARY KEY AUTOINCREMENT, player_id INTEGER NOT NULL, item_id INTEGER NOT NULL,
+        item_type INTEGER DEFAULT 0, tile_x INTEGER DEFAULT 0, tile_y INTEGER DEFAULT 0, placed INTEGER DEFAULT 1
+      );
+      CREATE TABLE IF NOT EXISTS house_plants (
+        id INTEGER PRIMARY KEY AUTOINCREMENT, player_id INTEGER NOT NULL, plant_id INTEGER NOT NULL,
+        tile INTEGER DEFAULT 0, state TEXT DEFAULT 'growing', planted_at INTEGER NOT NULL
+      );
+      CREATE TABLE IF NOT EXISTS storage_items (
+        id INTEGER PRIMARY KEY AUTOINCREMENT, user_id INTEGER NOT NULL, item_id INTEGER NOT NULL,
+        quantity INTEGER DEFAULT 1, added_at INTEGER NOT NULL
+      );
+      CREATE TABLE IF NOT EXISTS recycle_items (
+        id INTEGER PRIMARY KEY AUTOINCREMENT, user_id INTEGER NOT NULL, item_id INTEGER NOT NULL,
+        quantity INTEGER DEFAULT 1, added_at INTEGER NOT NULL
+      );
+      CREATE TABLE IF NOT EXISTS potions (
+        id INTEGER PRIMARY KEY AUTOINCREMENT, user_id INTEGER NOT NULL, potion_id INTEGER NOT NULL,
+        quantity INTEGER DEFAULT 1, added_at INTEGER NOT NULL
+      );
+      CREATE TABLE IF NOT EXISTS bans (
+        id INTEGER PRIMARY KEY AUTOINCREMENT, user_id INTEGER NOT NULL, reason TEXT DEFAULT '',
+        banned_by INTEGER, created_at INTEGER NOT NULL
+      );
+      CREATE TABLE IF NOT EXISTS daily_rewards (
+        id INTEGER PRIMARY KEY AUTOINCREMENT, user_id INTEGER NOT NULL, day TEXT NOT NULL,
+        claimed INTEGER DEFAULT 0, data TEXT DEFAULT '{}', UNIQUE(user_id, day)
+      );
+      CREATE TABLE IF NOT EXISTS high_scores (
+        id INTEGER PRIMARY KEY AUTOINCREMENT, user_id INTEGER NOT NULL, game_id INTEGER NOT NULL,
+        score INTEGER NOT NULL, period TEXT DEFAULT 'daily', played_at INTEGER NOT NULL
+      );
+      CREATE TABLE IF NOT EXISTS buddy_requests (
+        user_id INTEGER NOT NULL, buddy_id INTEGER NOT NULL, created_at INTEGER NOT NULL,
+        PRIMARY KEY (user_id, buddy_id)
+      );
+    `);
+
+    // Columns the extension handlers read but the index.ts schema omitted.
+    this.addColumn("users", "credits", "INTEGER NOT NULL DEFAULT 0");
+    this.addColumn("users", "skin_tone", "TEXT NOT NULL DEFAULT '1'");
+    this.addColumn("users", "last_room_id", "INTEGER NOT NULL DEFAULT -1");
+    this.addColumn("user_items", "item_type", "INTEGER NOT NULL DEFAULT 0");
+    this.addColumn("user_items", "item_ordinal", "INTEGER NOT NULL DEFAULT 0");
+    this.addColumn("user_items", "slot_id", "INTEGER NOT NULL DEFAULT 0");
+    this.addColumn("user_animals", "days_left", "INTEGER NOT NULL DEFAULT 30");
+    this.addColumn("user_animals", "cleanliness", "INTEGER NOT NULL DEFAULT 100");
+    this.addColumn("user_cards", "series_id", "INTEGER NOT NULL DEFAULT 0");
+    this.addColumn("user_cards", "album_id", "INTEGER NOT NULL DEFAULT 0");
+    this.addColumn("user_quests", "stage", "INTEGER NOT NULL DEFAULT 0");
+    this.addColumn("user_quests", "completed", "INTEGER NOT NULL DEFAULT 0");
+
+    // Static world data. Seed only when empty so deployments keep their edits.
+    const hasRealRoom = this.get("SELECT 1 AS ok FROM rooms WHERE id >= 101 LIMIT 1") as Row | undefined;
+    if (!hasRealRoom) {
+      const staticRooms = path.resolve(__dirname, "../../static-data/S_ROOMS_DATA.json");
+      if (fs.existsSync(staticRooms)) {
+        try {
+          const parsed = JSON.parse(fs.readFileSync(staticRooms, "utf8")) as {
+            rooms?: Array<{ id: number; name: string; swf: string; zone: number; maxUsers: number; portals?: number[] }>;
+          };
+          const insertRoom = this.db.prepare(
+            "INSERT OR REPLACE INTO rooms (id, name, swf_file, sound_file, zone_name, max_users) VALUES (?, ?, ?, '', ?, ?)"
+          );
+          const insertPortal = this.db.prepare(
+            "INSERT INTO room_portals (room_id, portal_id, target_room_id) VALUES (?, ?, ?)"
+          );
+          this.run("DELETE FROM room_portals");
+          for (const room of parsed.rooms ?? []) {
+            insertRoom.run(room.id, room.name, room.swf, `Zone ${room.zone}`, room.maxUsers ?? 40);
+            for (const target of room.portals ?? []) {
+              insertPortal.run(room.id, target, target);
+            }
+          }
+        } catch (error) {
+          console.error("[DB] Could not seed rooms from static data:", (error as Error).message);
+        }
+      }
+      if (((this.get("SELECT COUNT(*) AS n FROM rooms") as Row).n as number) === 0) {
+        this.run("INSERT INTO rooms (id, name, swf_file, sound_file, zone_name, max_users) VALUES (1, 'Channel1', 'room1', '', 'Ekoloko', 100)");
+      } else {
+        // Drop the old placeholder channel once real world rooms exist.
+        this.run("DELETE FROM rooms WHERE id = 1 AND name = 'Channel1'");
+      }
+    }
+  }
+
+  // ── accounts and players ──────────────────────────────────────────────
+  getAccountByUsername(username: string): Row {
+    return this.get("SELECT * FROM accounts WHERE username = ? COLLATE NOCASE", username);
+  }
+
+  getAccountById(id: number): Row {
+    return this.get("SELECT * FROM accounts WHERE id = ?", id);
+  }
+
+  getPlayerData(userId: number): Row {
+    return this.get("SELECT * FROM players WHERE account_id = ?", userId);
+  }
+
+  getFullPlayerProfile(userId: number): Row {
+    const account = this.getAccountById(userId);
+    if (!account) return undefined;
+    const player = this.getPlayerData(userId);
+    return { account, player, equippedItems: this.getEquippedItems(userId) };
+  }
+
+  createAccount(username: string, passwordHash: string, email: string, gender = "male"): number {
+    const result = this.db
+      .prepare("INSERT INTO users (username, password_hash, email, gender, created_at) VALUES (?, ?, ?, ?, ?)")
+      .run(username, passwordHash, email, gender, Date.now());
+    return Number(result.lastInsertRowid);
+  }
+
+  updateLastLogin(userId: number): void {
+    this.run("UPDATE users SET last_login = ? WHERE id = ?", Date.now(), userId);
+  }
+
+  updatePlayerGold(userId: number, delta: number): void {
+    this.run("UPDATE users SET coins = coins + ? WHERE id = ?", delta, userId);
+  }
+
+  updatePlayerCredits(userId: number, delta: number): void {
+    this.run("UPDATE users SET credits = credits + ? WHERE id = ?", delta, userId);
+  }
+
+  updatePlayerLevel(userId: number, level: number): void {
+    this.run("UPDATE users SET level = ? WHERE id = ?", level, userId);
+  }
+
+  updatePlayerLastRoom(userId: number, roomId: number): void {
+    this.run("UPDATE users SET last_room_id = ? WHERE id = ?", roomId, userId);
+  }
+
+  // ── inventory ─────────────────────────────────────────────────────────
+  getInventory(userId: number): Row[] {
+    return this.all("SELECT id, item_id, item_type, item_ordinal, slot_id, equipped FROM user_items WHERE user_id = ?", userId);
+  }
+
+  getInventoryItemById(inventoryId: number, userId?: number): Row {
+    return userId === undefined
+      ? this.get("SELECT * FROM user_items WHERE id = ?", inventoryId)
+      : this.get("SELECT * FROM user_items WHERE id = ? AND user_id = ?", inventoryId, userId);
+  }
+
+  getEquippedItems(userId: number): Row[] {
+    return this.all("SELECT id, item_id, item_type, slot_id FROM user_items WHERE user_id = ? AND equipped = 1", userId);
+  }
+
+  hasItem(userId: number, itemId: number): boolean {
+    return Boolean(this.get("SELECT 1 AS ok FROM user_items WHERE user_id = ? AND item_id = ?", userId, itemId));
+  }
+
+  addInventoryItem(userId: number, itemId: number, itemType = 0, slotId = 0): void {
+    this.run(
+      "INSERT INTO user_items (user_id, item_id, item_type, slot_id, quantity, obtained_at) VALUES (?, ?, ?, ?, 1, ?)",
+      userId, itemId, itemType, slotId, Date.now()
+    );
+  }
+
+  removeInventoryItem(userId: number, inventoryId: number): void {
+    this.run("DELETE FROM user_items WHERE user_id = ? AND id = ?", userId, inventoryId);
+  }
+
+  removeInventoryItemByItemId(userId: number, itemId: number): void {
+    this.run("DELETE FROM user_items WHERE user_id = ? AND item_id = ? AND id IN (SELECT id FROM user_items WHERE user_id = ? AND item_id = ? LIMIT 1)", userId, itemId, userId, itemId);
+  }
+
+  equipItem(userId: number, inventoryId: number, slotId = 0): void {
+    this.run("UPDATE user_items SET equipped = 1, slot_id = ? WHERE user_id = ? AND id = ?", slotId, userId, inventoryId);
+  }
+
+  unequipItem(userId: number, inventoryId: number): void {
+    this.run("UPDATE user_items SET equipped = 0 WHERE user_id = ? AND id = ?", userId, inventoryId);
+  }
+
+  addStorageItem(userId: number, itemId: number, itemType = 0, itemOrdinal = 0): void {
+    void itemType; void itemOrdinal;
+    this.run("INSERT INTO storage_items (user_id, item_id, quantity, added_at) VALUES (?, ?, 1, ?)", userId, itemId, Date.now());
+  }
+
+  getStorage(userId: number): Row[] {
+    return this.all("SELECT * FROM storage_items WHERE user_id = ?", userId);
+  }
+
+  addRecycleItem(userId: number, itemId: number, quantity = 1): void {
+    this.run("INSERT INTO recycle_items (user_id, item_id, quantity, added_at) VALUES (?, ?, ?, ?)", userId, itemId, quantity, Date.now());
+  }
+
+  getRecycleItems(userId: number): Row[] {
+    return this.all("SELECT * FROM recycle_items WHERE user_id = ?", userId);
+  }
+
+  removeRecycleItem(userId: number, id: number): void {
+    this.run("DELETE FROM recycle_items WHERE user_id = ? AND id = ?", userId, id);
+  }
+
+  addPotion(userId: number, potionId: number, quantity = 1): void {
+    this.run("INSERT INTO potions (user_id, potion_id, quantity, added_at) VALUES (?, ?, ?, ?)", userId, potionId, quantity, Date.now());
+  }
+
+  getPotions(userId: number): Row[] {
+    return this.all("SELECT * FROM potions WHERE user_id = ?", userId);
+  }
+
+  removePotion(userId: number, potionId: number): void {
+    this.run("DELETE FROM potions WHERE user_id = ? AND potion_id = ?", userId, potionId);
+  }
+
+  // ── cards ─────────────────────────────────────────────────────────────
+  addCard(userId: number, cardId: number, seriesId = 0, albumId = 0): void {
+    this.run("INSERT INTO user_cards (user_id, card_id, series_id, album_id, quantity) VALUES (?, ?, ?, ?, 1)", userId, cardId, seriesId, albumId);
+  }
+
+  getCards(userId: number): Row[] {
+    return this.all("SELECT id, card_id, series_id, album_id, quantity FROM user_cards WHERE user_id = ?", userId);
+  }
+
+  getCardsByAlbum(userId: number, albumId: number): Row[] {
+    return this.all("SELECT id, card_id, series_id, album_id, quantity FROM user_cards WHERE user_id = ? AND album_id = ?", userId, albumId);
+  }
+
+  // ── animals ───────────────────────────────────────────────────────────
+  getAnimals(userId: number): Row[] {
+    return this.all("SELECT * FROM user_animals WHERE user_id = ?", userId);
+  }
+
+  addAnimal(userId: number, animalId: number, name: string): void {
+    this.run("INSERT INTO user_animals (user_id, animal_id, name, adopted_at) VALUES (?, ?, ?, ?)", userId, animalId, name, Date.now());
+  }
+
+  renameAnimal(animalId: number, name: string): void {
+    this.run("UPDATE user_animals SET name = ? WHERE id = ?", name, animalId);
+  }
+
+  feedAnimal(animalId: number): void {
+    this.run("UPDATE user_animals SET hunger = MIN(100, hunger + 20), happiness = MIN(100, happiness + 20), last_fed = ? WHERE id = ?", Date.now(), animalId);
+  }
+
+  cleanAnimal(animalId: number): void {
+    this.run("UPDATE user_animals SET cleanliness = MIN(100, cleanliness + 20) WHERE id = ?", animalId);
+  }
+
+  // ── buddies ───────────────────────────────────────────────────────────
+  getBuddies(userId: number): Row[] {
+    return this.all("SELECT b.buddy_id, a.username FROM user_buddies b LEFT JOIN accounts a ON a.id = b.buddy_id WHERE b.user_id = ?", userId);
+  }
+
+  getPendingBuddyRequests(userId: number): Row[] {
+    return this.all("SELECT br.buddy_id AS player_id, a.username FROM buddy_requests br LEFT JOIN accounts a ON a.id = br.buddy_id WHERE br.user_id = ?", userId);
+  }
+
+  getBuddyRelation(userId: number, buddyId: number): Row {
+    return this.get("SELECT * FROM user_buddies WHERE user_id = ? AND buddy_id = ?", userId, buddyId);
+  }
+
+  addBuddy(userId: number, buddyId: number): void {
+    this.run("INSERT OR IGNORE INTO user_buddies (user_id, buddy_id, added_at) VALUES (?, ?, ?)", userId, buddyId, Date.now());
+    this.run("DELETE FROM buddy_requests WHERE user_id = ? AND buddy_id = ?", userId, buddyId);
+  }
+
+  acceptBuddy(userId: number, buddyId: number): void {
+    this.addBuddy(userId, buddyId);
+    this.addBuddy(buddyId, userId);
+  }
+
+  removeBuddy(userId: number, buddyId: number): void {
+    this.run("DELETE FROM user_buddies WHERE user_id = ? AND buddy_id = ?", userId, buddyId);
+  }
+
+  // ── quests ────────────────────────────────────────────────────────────
+  getQuest(userId: number, questId: number): Row {
+    return this.get("SELECT * FROM user_quests WHERE user_id = ? AND quest_id = ? ORDER BY id DESC", userId, questId);
+  }
+
+  getQuests(userId: number): Row[] {
+    return this.all("SELECT quest_id, stage, status, progress, completed, started_at, completed_at FROM user_quests WHERE user_id = ?", userId);
+  }
+
+  startQuest(userId: number, questId: number): void {
+    this.run("INSERT INTO user_quests (user_id, quest_id, status, stage, started_at) VALUES (?, ?, 'active', 0, ?)", userId, questId, Date.now());
+  }
+
+  updateQuestStage(userId: number, questId: number, stage: number): void {
+    this.run("UPDATE user_quests SET stage = ?, status = 'active' WHERE user_id = ? AND quest_id = ?", stage, userId, questId);
+  }
+
+  completeQuest(userId: number, questId: number): void {
+    this.run("UPDATE user_quests SET status = 'completed', completed = 1, completed_at = ? WHERE user_id = ? AND quest_id = ?", Date.now(), userId, questId);
+  }
+
+  // ── house ─────────────────────────────────────────────────────────────
+  getHouse(userId: number): Row {
+    let house = this.get("SELECT * FROM houses WHERE player_id = ?", userId);
+    if (!house) {
+      this.run("INSERT INTO houses (player_id) VALUES (?)", userId);
+      house = this.get("SELECT * FROM houses WHERE player_id = ?", userId);
+    }
+    return house;
+  }
+
+  updateHouseType(userId: number, typeId: number): void {
+    this.getHouse(userId);
+    this.run("UPDATE houses SET type_id = ? WHERE player_id = ?", typeId, userId);
+  }
+
+  upgradeHouseSize(userId: number, size: number): void {
+    this.getHouse(userId);
+    this.run("UPDATE houses SET size = ? WHERE player_id = ?", size, userId);
+  }
+
+  upgradeHouseElectric(userId: number, level: number): void {
+    this.getHouse(userId);
+    this.run("UPDATE houses SET electric_level = ? WHERE player_id = ?", level, userId);
+  }
+
+  getHouseItems(playerId: number): Row[] {
+    return this.all("SELECT * FROM house_items WHERE player_id = ?", playerId);
+  }
+
+  placeHouseItem(itemId: number, tileX: number, tileY: number): void {
+    this.run("UPDATE house_items SET tile_x = ?, tile_y = ?, placed = 1 WHERE id = ?", tileX, tileY, itemId);
+  }
+
+  unplaceHouseItem(itemId: number): void {
+    this.run("UPDATE house_items SET placed = 0 WHERE id = ?", itemId);
+  }
+
+  addHousePlant(userId: number, plantId: number, tile: number): void {
+    this.run("INSERT INTO house_plants (player_id, plant_id, tile, planted_at) VALUES (?, ?, ?, ?)", userId, plantId, tile, Date.now());
+  }
+
+  getHousePlants(userId: number): Row[] {
+    return this.all("SELECT * FROM house_plants WHERE player_id = ?", userId);
+  }
+
+  removeHousePlant(plantId: number): void {
+    this.run("DELETE FROM house_plants WHERE id = ?", plantId);
+  }
+
+  waterPlant(plantId: number): void {
+    this.run("UPDATE house_plants SET state = 'watered' WHERE id = ?", plantId);
+  }
+
+  updatePlantState(plantId: number, state: string): void {
+    this.run("UPDATE house_plants SET state = ? WHERE id = ?", state, plantId);
+  }
+
+  // ── world / stores / scores ───────────────────────────────────────────
+  getRoomData(roomId: number): Row {
+    return this.get("SELECT * FROM rooms WHERE id = ?", roomId);
+  }
+
+  getRoomPortals(roomId: number): Row[] {
+    return this.all("SELECT * FROM room_portals WHERE room_id = ?", roomId);
+  }
+
+  getRoomNpcs(roomId: number): Row[] {
+    return this.all("SELECT * FROM room_npcs WHERE room_id = ?", roomId);
+  }
+
+  getStore(storeId: number): Row {
+    return this.get("SELECT * FROM stores WHERE id = ?", storeId);
+  }
+
+  addHighScore(userId: number, gameId: number, score: number, period = "daily"): void {
+    this.run("INSERT INTO high_scores (user_id, game_id, score, period, played_at) VALUES (?, ?, ?, ?, ?)", userId, gameId, score, period, Date.now());
+  }
+
+  getHighScores(gameId: number, period = "daily", limit = 10): Row[] {
+    return this.all("SELECT h.user_id, a.username, h.score FROM high_scores h LEFT JOIN accounts a ON a.id = h.user_id WHERE h.game_id = ? AND h.period = ? ORDER BY h.score DESC LIMIT ?", gameId, period, limit);
+  }
+
+  addBan(userId: number, reason: string, bannedBy = 0, _active = 1): void {
+    this.run("INSERT INTO bans (user_id, reason, banned_by, created_at) VALUES (?, ?, ?, ?)", userId, reason, bannedBy, Date.now());
+    this.run("UPDATE users SET is_banned = 1, ban_reason = ? WHERE id = ?", reason, userId);
+  }
+
+  // ── daily rewards ─────────────────────────────────────────────────────
+  getDailyReward(userId: number, day: string): Row {
+    return this.get("SELECT * FROM daily_rewards WHERE user_id = ? AND day = ?", userId, day);
+  }
+
+  addDailyReward(userId: number, day: string, data: Row = {}): void {
+    this.run("INSERT OR IGNORE INTO daily_rewards (user_id, day, data) VALUES (?, ?, ?)", userId, day, JSON.stringify(data));
+  }
+
+  claimDailyReward(userId: number, day: string): void {
+    this.addDailyReward(userId, day);
+    this.run("UPDATE daily_rewards SET claimed = 1 WHERE user_id = ? AND day = ?", userId, day);
+  }
+}
+
+export default Database;
