# Copy to .env and adjust. Never commit real secrets.
EKOLOKO_HOST=localhost
GAME_ASSETS_ROOT=client
HTTP_PORT=8080
TCP_PORT=9339

# Desktop wrapper (used by desktop after the local-target patch)
EKOLOKO_PROD_URL=http://localhost:8080/launcher.html
EKOLOKO_BETA_URL=http://localhost:8080/launcher.html
EKOLOKO_ALLOWED_HOSTS=localhost,127.0.0.1
# For development runs only:
EKOLOKO_ALLOW_LOCAL=1

# Admin CLI
ADMIN_ACTOR=devops
# EKOLOKO_DB=/absolute/path/to/ekoloko.db

# ── Admin dashboard ────────────────────────────────────────────────────
# Dev default is SQLite (same DB as the game server). Prod uses Postgres.
DB_DRIVER=sqlite
# DATABASE_URL=postgres://user:pass@postgres:5432/ekoloko
# Alternative to DATABASE_URL: PGHOST/PGPORT/PGDATABASE/PGUSER/PGPASSWORD
PGDATABASE=ekoloko
PGUSER=ekoloko
# PGPASSWORD=change-me

# Redis-backed sessions. Without REDIS_URL the console uses in-memory sessions (dev only).
# REDIS_URL=redis://redis:6379
SESSION_SECRET=replace-with-a-long-random-value

# Bootstrap owner on first startup (leave unset after the first account exists).
ADMIN_BOOTSTRAP_USER=root
ADMIN_BOOTSTRAP_PASSWORD=change-me-please

# Optional: comma-separated IPs/CIDR prefixes allowed to reach /admin.
# ADMIN_IP_ALLOWLIST=127.0.0.1,::1

# Set to false only for local development if 2FA on writes is impractical.
ADMIN_REQUIRE_TOTP=true

# Postgres pool / TLS (prod)
PGPOOL_MAX=10
PGSSL=false

# Dev infra (docker compose): postgres/redis ports and credentials
POSTGRES_DB=ekoloko
POSTGRES_USER=ekoloko
POSTGRES_PASSWORD=change-me
REDIS_PORT=6379
